{
    "version": 3,
    "cmakeMinimumRequired": { "major": 3, "minor": 21, "patch": 0 },
    "configurePresets": [
        {
            "name": "windows-debug",
            "displayName": "Windows Debug (MinGW/Ninja)",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/windows-debug",
            "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" },
            "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
        },
        {
            "name": "windows-release",
            "inherits": "windows-debug",
            "displayName": "Windows Release (MinGW/Ninja)",
            "binaryDir": "${sourceDir}/build/windows-release",
            "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
        },
        {
            "name": "windows-release-static",
            "inherits": "windows-release",
            "displayName": "Windows Release, statically linked (MinGW/Ninja)",
            "binaryDir": "${sourceDir}/build/windows-release-static",
            "cacheVariables": { "BUILD_STATIC": "ON" }
        },
        {
            "name": "windows-debug-static",
            "inherits": "windows-debug",
            "displayName": "Windows Debug, statically linked (MinGW/Ninja)",
            "binaryDir": "${sourceDir}/build/windows-debug-static",
            "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "BUILD_STATIC": "ON" }
        },
        {
            "name": "macos-debug",
            "displayName": "macOS Debug (universal, command-line build)",
            "generator": "Unix Makefiles",
            "binaryDir": "${sourceDir}/build/macos-debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_OSX_ARCHITECTURES": "x86_64;arm64",
                "CMAKE_OSX_DEPLOYMENT_TARGET": "10.9"
            },
            "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin" }
        },
        {
            "name": "macos-release",
            "inherits": "macos-debug",
            "displayName": "macOS Release (universal, command-line build)",
            "binaryDir": "${sourceDir}/build/macos-release",
            "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
        },
        {
            "name": "macos-xcode",
            "inherits": "macos-debug",
            "displayName": "macOS (generates SDL3Stuff.xcodeproj)",
            "generator": "Xcode",
            "binaryDir": "${sourceDir}/build/macos-xcode"
        },
        {
            "name": "ios-device",
            "displayName": "iOS Device (generates SDL3Stuff.xcodeproj)",
            "generator": "Xcode",
            "binaryDir": "${sourceDir}/build/ios-device",
            "toolchainFile": "${sourceDir}/cmake/ios.toolchain.cmake",
            "cacheVariables": {
                "PLATFORM": "OS64",
                "DEPLOYMENT_TARGET": "13.0"
            },
            "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin" }
        },
        {
            "name": "ios-simulator",
            "inherits": "ios-device",
            "displayName": "iOS Simulator, Apple Silicon (generates SDL3Stuff.xcodeproj)",
            "binaryDir": "${sourceDir}/build/ios-simulator",
            "cacheVariables": {
                "PLATFORM": "SIMULATORARM64",
                "DEPLOYMENT_TARGET": "13.0"
            }
        },
        {
            "name": "linux-debug",
            "displayName": "Linux Debug",
            "generator": "Unix Makefiles",
            "binaryDir": "${sourceDir}/build/linux-debug",
            "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" },
            "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" }
        },
        {
            "name": "linux-release",
            "inherits": "linux-debug",
            "displayName": "Linux Release",
            "binaryDir": "${sourceDir}/build/linux-release",
            "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
        }
    ],
    "buildPresets": [
        { "name": "windows-debug", "configurePreset": "windows-debug" },
        { "name": "windows-release", "configurePreset": "windows-release" },
        { "name": "windows-release-static", "configurePreset": "windows-release-static" },
        { "name": "windows-debug-static", "configurePreset": "windows-debug-static" },
        { "name": "macos-debug", "configurePreset": "macos-debug" },
        { "name": "macos-release", "configurePreset": "macos-release" },
        { "name": "macos-xcode", "configurePreset": "macos-xcode" },
        { "name": "ios-device", "configurePreset": "ios-device" },
        { "name": "ios-simulator", "configurePreset": "ios-simulator" },
        { "name": "linux-debug", "configurePreset": "linux-debug" },
        { "name": "linux-release", "configurePreset": "linux-release" }
    ]
}
